set dotenv-load
set dotenv-filename := ".env"

bin_dir := source_directory() / "bin"
dev_firestore_emulator_port := "8090"
test_firestore_emulator_port := "8091"

# Download Go module dependencies and install the Firestore emulator.
setup:
    cd {{source_directory()}} && go mod download
    gcloud components install cloud-firestore-emulator --quiet

# Run the API dev server. Requires the Firestore emulator (see
# `firestore-emulator`) and a configured .env; see .env.example.
dev:
    cd {{source_directory()}} && go run ./cmd/server

# Run the Firestore emulator for local development. Leave running in a
# separate terminal; `dev` expects FIRESTORE_EMULATOR_HOST in .env to point
# at it (see .env.example). `gcloud` runs the actual emulator (a Java
# process) in its own process group, so it doesn't receive Ctrl+C's SIGINT;
# `gcloud` is backgrounded and `wait`ed on (rather than run as a plain
# foreground command) so this script itself stays responsive to the signal,
# and the trap force-kills whatever is still listening on the port on exit.
firestore-emulator:
    #!/usr/bin/env bash
    set -uo pipefail
    gcloud emulators firestore start --host-port=localhost:{{dev_firestore_emulator_port}} &
    emulator_pid=$!
    trap 'kill "$emulator_pid" 2>/dev/null || true; kill $(lsof -ti:{{dev_firestore_emulator_port}} 2>/dev/null) 2>/dev/null || true' EXIT
    wait "$emulator_pid"

# Build the API binary.
build:
    cd {{source_directory()}} && go build -o {{bin_dir}}/server ./cmd/server

# Run Go tests, starting a throwaway Firestore emulator for the duration of
# the run so store integration tests aren't skipped.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{source_directory()}}
    gcloud emulators firestore start --host-port=localhost:{{test_firestore_emulator_port}} \
        &> /tmp/siorie-firestore-test-emulator.log &
    emulator_pid=$!
    # `gcloud` runs the actual emulator (a Java process) in its own process
    # group, so killing emulator_pid (the gcloud wrapper) alone leaves it
    # running; the port-based kill below is the reliable way to reap it.
    trap 'kill "$emulator_pid" 2>/dev/null || true; wait "$emulator_pid" 2>/dev/null || true; kill $(lsof -ti:{{test_firestore_emulator_port}} 2>/dev/null) 2>/dev/null || true' EXIT
    for _ in $(seq 1 60); do
        if curl -s -o /dev/null http://localhost:{{test_firestore_emulator_port}}/; then
            break
        fi
        sleep 0.5
    done
    FIRESTORE_EMULATOR_HOST=localhost:{{test_firestore_emulator_port}} go test ./...

# Run static analysis.
lint:
    cd {{source_directory()}} && go vet ./...

# Format Go source files.
format:
    cd {{source_directory()}} && gofmt -w .

# Fail if any Go source file is not gofmt-formatted.
format-check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{source_directory()}}
    unformatted=$(gofmt -l .)
    if [ -n "$unformatted" ]; then
        echo "The following files are not gofmt-formatted:"
        echo "$unformatted"
        exit 1
    fi

# Run format-check, lint, test, and build.
check: format-check lint test build
