# Web OAuth 2.0 client ID from Google Cloud Console (APIs & Services >
# Credentials). Used server-side to verify the "aud" claim on Google ID
# Tokens. See docs/discussions/20260823-purpose-and-initial-tech-stack/proposal.md.
GOOGLE_CLIENT_ID=

# Not read by the server. The ID Token flow this app uses does not need a
# client secret (proposal: "OAuth クライアントシークレットはブラウザにもコンテナにも配置しない").
# Kept as a placeholder only because it was listed as a prerequisite in the
# discovery note; see docs/worklogs/20260823-google-auth/README.md.
GOOGLE_CLIENT_SECRET=

# The application's own origin, checked against the Origin header on
# state-changing requests. In local dev this is the Vite dev server's
# origin — the browser only ever talks to Vite, which proxies /api/* to
# this server (see apps/web/vite.config.ts).
APP_ORIGIN=http://localhost:5173

# Firestore project ID. Any placeholder works against the local emulator.
FIRESTORE_PROJECT_ID=siorie

# Set for local dev to use the Firestore emulator instead of production
# Firestore. Run `just apps/api/firestore-emulator` first. Unset in
# production.
FIRESTORE_EMULATOR_HOST=localhost:8090
