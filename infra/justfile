infra_dir := source_directory()
repo_root := parent_directory(source_directory())

# Artifact Registry Docker path for the deploy image (repository from
# infra/platform/, image name `app`). Tagged with the short commit SHA at push
# time; no `:latest`.
ar_host := "asia-northeast1-docker.pkg.dev"
image := ar_host / "siorie/siorie/app"

# Terraform layers are root modules under infra/<layer>/, split by change
# frequency (discussion 0027):
#   bootstrap  almost never changes  — local committed state
#   platform   changes rarely        — gs://siorie-tfstate/platform (APIs
#              consumed via bootstrap; Artifact Registry, Firestore, runtime SA
#              + roles/datastore.user)
#   app        changes every deploy  — gs://siorie-tfstate/app (Cloud Run
#              service + public invoker)
# infra/app/ reads infra/platform/ resources through data sources with no
# cross-module depends_on, so when both change, apply platform before app.
# Recipes take the layer name and are independent of the caller's working
# directory. Local apply uses the operator's Application Default Credentials
# (`gcloud auth application-default login`); no service-account keys.

# terraform init for a layer, e.g. `just infra/init bootstrap`.
init layer:
    terraform -chdir={{infra_dir}}/{{layer}} init

# terraform plan for a layer. Trailing args pass straight to terraform, e.g.
# `just infra/plan app -var image_tag=<sha> -var google_client_id=<id>`.
plan layer *args:
    terraform -chdir={{infra_dir}}/{{layer}} plan {{args}}

# terraform apply for a layer. Trailing args pass straight to terraform, e.g.
# `just infra/apply app -var image_tag=<sha> -var google_client_id=<id>`.
apply layer *args:
    terraform -chdir={{infra_dir}}/{{layer}} apply {{args}}

# terraform output for a layer.
output layer:
    terraform -chdir={{infra_dir}}/{{layer}} output

# Rewrite Terraform files under infra/ to canonical format.
format:
    terraform fmt -recursive {{infra_dir}}

# Fail if any Terraform file under infra/ is not canonically formatted.
format-check:
    terraform fmt -recursive -check {{infra_dir}}

# --- Deploy container image ---------------------------------------------------
# Build/push run on the operator's local container engine; Cloud Build is not
# used. The engine is outside mise's version pinning.
#
# A Docker-compatible engine is assumed. podman (Docker CLI emulation) works —
# `build` and `push` behave the same — but its config paths differ:
#   - `docker-auth` writes a credential helper into ~/.docker/config.json.
#     podman's native credential store is ~/.config/containers/auth.json; it
#     does fall back to ~/.docker/config.json and honours credHelpers, and
#     docker-credential-gcloud ships on PATH with the gcloud SDK, so the helper
#     should resolve. If a push still fails on auth, log in directly instead:
#       gcloud auth print-access-token \
#         | docker login -u oauth2accesstoken --password-stdin {{ar_host}}
#   - The Dockerfile's builder line `FROM golang:1.27-bookworm` is unqualified.
#     Docker implies docker.io/library/; podman needs a short-name alias or
#     unqualified-search entry (a strict `short-name-mode = enforcing` config
#     would break a non-interactive run).

# Point the engine at the Artifact Registry host using your gcloud user
# credentials. Run once per machine — it writes ~/.docker/config.json.
# Deliberately not part of `setup`: it mutates a shared, user-global config
# file. See the note above if you are on podman.
docker-auth:
    gcloud auth configure-docker {{ar_host}}

# Build the deploy image from the repo root and push it to Artifact Registry,
# tagged with `git rev-parse --short=12 HEAD`. Runs regardless of whether the
# working tree is dirty (the tag can then disagree with the pushed contents —
# operator's responsibility). Requires `docker-auth` once and the Artifact
# Registry repository (`just infra/apply platform`).
#
# google_client_id is the OAuth Web client ID, inlined into the SPA bundle by
# `vite build` (--build-arg VITE_GOOGLE_CLIENT_ID). It must be the same value
# later passed to `just infra/apply app -var google_client_id=…`; a mismatch is
# a silent sign-in 401 (proposal 0028).
publish-image google_client_id:
    #!/usr/bin/env bash
    set -euo pipefail
    sha="$(git -C {{repo_root}} rev-parse --short=12 HEAD)"
    ref="{{image}}:${sha}"
    echo "publishing ${ref}"
    docker build -f {{infra_dir}}/Dockerfile \
      --build-arg VITE_GOOGLE_CLIENT_ID={{google_client_id}} \
      -t "${ref}" {{repo_root}}
    docker push "${ref}"

# Roll the Cloud Run service (infra/app/) to a published image:
#   just infra/publish-image <oauth-web-client-id>
#   just infra/apply app \
#     -var image_tag=$(git rev-parse --short=12 HEAD) \
#     -var google_client_id=<oauth-web-client-id> \
#     -var app_origin=<cloud-run-url>
# image_tag, google_client_id, and app_origin have no defaults, so every app
# plan/apply needs all three -var flags (or the matching TF_VAR_* set in the
# environment). image_tag must be a tag that exists in Artifact Registry — run
# publish-image first if you want the current HEAD. app_origin is the service's
# real public URL (`just infra/output app` → cloud_run_url). The platform and
# bootstrap layers take no -var flags.
