.local/

# Local secrets, not shared via version control
/apps/api/.env
/apps/web/.env

# Generated by apps/api
/apps/api/bin/

# Generated by apps/web
/apps/web/dist/
/apps/web/node_modules/

# Terraform. infra/bootstrap/terraform.tfstate and infra/**/.terraform.lock.hcl
# are committed on purpose (see docs/discussions/0022-terraform-gcp-bootstrap/).
**/.terraform/*
*.tfplan
/infra/bootstrap/terraform.tfstate.backup
/infra/prod/*.tfstate
/infra/prod/*.tfstate.*
