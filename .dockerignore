# The build context for infra/Dockerfile is the repository root. Keep only what
# the Go and web builds need; everything below is either irrelevant to them or
# must not end up in a build layer.

# VCS and tooling
.git
.claude
.local

# Node / web. The web stage always installs and builds from source inside the
# image, so a stale local node_modules or dist must never leak into the context.
node_modules
apps/web/node_modules
apps/web/dist

# Go build output
apps/api/bin

# Terraform working dirs, state, and plans
**/.terraform
*.tfstate
*.tfstate.*
*.tfplan

# Docs
docs

# Local env files (keep .env.example, which does not match these)
.env
apps/*/.env
